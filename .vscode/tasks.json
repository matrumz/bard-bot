{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BardBot.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/BardBot.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/BardBot.sln"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "update secrets",
      "command": "bash",
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}/src/BardBot"
      },
      "args": [
        "-c",
        "cat secrets.json | dotnet user-secrets set"
      ],
      "problemMatcher": []
    }
  ]
}
